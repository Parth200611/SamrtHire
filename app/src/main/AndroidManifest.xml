<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartHire"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".JobSeeker.Fragment.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:name=".JobSeeker.Fragment.Profile.UpdateProfileActivity"
            android:exported="false" />
        <activity
            android:name=".Recruiter.RecruiterDashboardActivity"
            android:exported="false" />
        <activity
            android:name=".Recruiter.RecruiterRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".JobSeeker.JobSeekerHomeActivity"
            android:exported="false" />
        <activity
            android:name=".JobSeeker.JobSeekerRegister"
            android:exported="false" />
        <activity
            android:name=".Recruiter.RecruiterLoginActivity"
            android:exported="false" />
        <activity
            android:name=".JobSeeker.JobSeekerLoginActivity"
            android:exported="false" />
        <activity
            android:name=".WelcomeActivity"
            android:exported="false" />
        <activity
            android:name=".Splashactivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>