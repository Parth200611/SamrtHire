<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    android:id="@+id/Job_card"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Category and openings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_job_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DBEAFE"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="IT / Software"
                android:textColor="#1D4ED8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_job_openings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3 Openings"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Job title -->
        <TextView
            android:id="@+id/tv_job_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Android Developer"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Department -->
        <TextView
            android:id="@+id/tv_job_department"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Information Technology"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic__location"
                android:contentDescription="Location"
                app:tint="#64748B" />

            <TextView
                android:id="@+id/tv_job_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:text="Pune, Maharashtra, India"
                android:textColor="#475569"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Experience -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_job_experience"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Experience: Fresher - 2 years"
                android:textColor="#475569"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_job_work_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#F1F5F9"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="Hybrid"
                android:textColor="#334155"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Employment and qualification -->
        <TextView
            android:id="@+id/tv_job_employment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Full Time  •  Graduate"
            android:textColor="#475569"
            android:textSize="12sp" />

        <!-- Salary -->
        <TextView
            android:id="@+id/tv_job_salary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="₹3,00,000 - ₹6,00,000 Per Year"
            android:textColor="#15803D"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Required skills -->
        <TextView
            android:id="@+id/tv_job_skills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Java, Android, XML, MySQL"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Bottom divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#E2E8F0" />

        <!-- Deadline and status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_job_deadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Apply before: 31 Dec 2026"
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_job_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCFCE7"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="Published"
                android:textColor="#15803D"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
