<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".JobSeeker.Fragment.Application.ApplicatFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Applications"
                android:textColor="#0F172A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Track your job applications and stay updated on their progress."
                android:textColor="#64748B"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progress_applications"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:indeterminateTint="#1D4ED8"
            android:visibility="gone" />

        <!-- Empty message -->
        <TextView
            android:id="@+id/tv_no_applications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="25dp"
            android:text="No applications found."
            android:textColor="#64748B"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Applications RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_my_applications"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_my_application" />

    </LinearLayout>

</FrameLayout>
