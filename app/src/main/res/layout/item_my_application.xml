<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="7dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="#E8EDF5"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Job title and status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_application_job_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Android Developer"
                android:textColor="#0F172A"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_application_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#DBEAFE"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:text="Applied"
                android:textColor="#1D4ED8"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Recruiter email -->
        <TextView
            android:id="@+id/tv_application_recruiter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Recruiter: hr@company.com"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="#EEF2F7" />

        <!-- Applied date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_calendar"
                android:contentDescription="Applied date"
              />

            <TextView
                android:id="@+id/tv_application_applied_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:text="Applied on: 24 Nov 2026"
                android:textColor="#475569"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Interview details -->
        <LinearLayout
            android:id="@+id/layout_interview_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#F1F5F9"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INTERVIEW DETAILS"
                android:textColor="#1D4ED8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_interview_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Date: 28 Nov 2026"
                android:textColor="#334155"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_interview_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Time: 11:00 AM"
                android:textColor="#334155"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_interview_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Mode: Online"
                android:textColor="#334155"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_interview_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Location: Office"
                android:textColor="#334155"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_interview_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Meeting link available"
                android:textColor="#1D4ED8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
